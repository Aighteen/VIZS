{
  "name": "spectrum",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "shop": "node src/launch.mjs",
    "shop:check": "node src/launch.mjs --check",
    "test": "node --test src/bridge-handler.test.mjs src/launch.test.mjs"
  },
  "dependencies": {
    "@spectrum-ts/imessage": "^12.11.0",
    "spectrum-ts": "^12.11.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
