# Copy this file to .env in the Python application root.
# Placeholders only; never commit real credentials.
# Loaded from this application root; process environment takes precedence.
# Keep offline until you intentionally enable requests that may use paid credits.
VIZS_PROVIDER_MODE=offline
VIZS_ENABLE_MOCK_SMS=false

XAI_API_KEY=replace_with_your_xai_api_key
# Replace with a model ID supported by your xAI account and structured output.
XAI_MODEL=replace_with_your_supported_model_id
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Photon Spectrum uses its separate app/adapters/spectrum/.env file.
# Its PROJECT_ID and PROJECT_SECRET are not xAI/Tavily credentials.

# Bounded latency budgets: extraction, then research, then reply.
VIZS_GROK_TIMEOUT_SECONDS=30
VIZS_EVALUATION_TIMEOUT_SECONDS=55
